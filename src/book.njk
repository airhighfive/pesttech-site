<h1>Book a Service</h1>
<p class="lede" style="margin-bottom:8px">Three ways for us to show up at a place and time we're needed.</p>
<p class="center"><b>Fastest:</b> call or text <a class="phone-inline" style="font-size:18px" href="tel:{{ site.phone.tel }}">{{ site.phone.display }}</a></p>

<h2>Schedule online (this doesn't reflect 100% of our availability)</h2>
{%- set bookingBar = "Pick a date + time" %}
{%- set bookingTall = true %}
{% include "booking-embed.njk" %}

<h2 id="request" style="margin-top:24px">Or send a request</h2>
<p class="note">We'll text you to confirm a time. Account and captcha not required.</p>
<form class="request-form" method="post" action="{{ site.booking.requestEndpoint }}">
  <label><span><b>Name</b></span><input type="text" name="name" autocomplete="name" required></label>
  <label><span><b>Phone</b> (we text this number)</span><input type="tel" name="phone" autocomplete="tel" required></label>
  <label><span><b>Service address</b></span><input type="text" name="address" autocomplete="street-address" required></label>
  <label><span><b>ZIP code</b></span><input type="text" name="zip" autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{5}(-[0-9]{4})?" maxlength="10" title="5-digit ZIP code" required></label>
  <label><span><b>What's bugging you?</b></span><textarea name="issue" rows="4" placeholder="e.g. cockroaches in the kitchen, mice in the attic, a Regular Service quote" required></textarea></label>
  <label><span><b>Preferred date</b> (optional)</span><input type="date" name="preferred_date"></label>
  <div class="hp" aria-hidden="true"><label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
  <input type="hidden" name="ts" id="ts" value="">
  <button type="submit">Send request →</button>
</form>
<p class="note">This is a request, not a confirmed appointment.</p>
<script>
  // Spam time-gate: the Worker drops submissions sent less than 3 seconds after the page loaded.
  document.getElementById("ts").value = Date.now();
</script>
